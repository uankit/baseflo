[importlinter]
root_packages =
    app
    tests

# Layered architecture per docs/05-coding-rules.md §3.1
# Reverse imports are forbidden.

[importlinter:contract:layered-architecture]
name = Baseflo layered architecture
type = layers
layers =
    app.api
    app.services
    app.orchestration
    app.engines : app.agents
    app.repositories
    app.db
    app.observability : app.core
ignore_imports =
    # core can be imported by anyone
    app.core -> *
    * -> app.core
    # observability is cross-cutting (logging, tracing decorators)
    app.observability -> app.core
    * -> app.observability

[importlinter:contract:agents-do-not-touch-db]
name = Agents must not touch the database directly
type = forbidden
source_modules =
    app.agents
forbidden_modules =
    app.db
    app.repositories
ignore_imports =
    # Agents may import typed schemas from db.models.types where applicable
    app.agents -> app.db.models.types
