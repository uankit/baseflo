# Baseflo server — environment example
# Copy to .env locally; never commit real secrets.

# ----- App -----
BASEFLO_ENV=local                       # local | staging | production
BASEFLO_LOG_LEVEL=info
BASEFLO_LOG_JSON=false                  # true in staging/prod
BASEFLO_API_BASE_URL=http://localhost:8000
BASEFLO_WEB_BASE_URL=http://localhost:5173
BASEFLO_REQUEST_ID_HEADER=X-Request-ID

# ----- Database -----
# Adjust user / password / port / database to match your local Postgres.
# Tests run against BASEFLO_DATABASE_URL too — point it at a *separate* DB
# (e.g. `baseflo_test`) when running `pytest -m integration` so they don't
# trash your dev data.
BASEFLO_DATABASE_URL=postgresql+asyncpg://baseflo:baseflo@localhost:5432/baseflo
BASEFLO_DATABASE_POOL_SIZE=10
BASEFLO_DATABASE_MAX_OVERFLOW=20

# ----- Redis (arq + caches) -----
# Use a dedicated DB number (e.g. /15) for tests if you share an instance with
# other apps to keep test keys isolated.
BASEFLO_REDIS_URL=redis://localhost:6379/0

# ----- LLM provider (OpenAI primary; Anthropic via env-flip per docs/00-decisions.md §7B) -----
BASEFLO_AGENT_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
BASEFLO_AGENT_FAST_MODEL_NAME=gpt-4.1-mini
BASEFLO_AGENT_BALANCED_MODEL_NAME=gpt-4.1
BASEFLO_AGENT_REASONING_MODEL_NAME=o3-mini
BASEFLO_AGENT_MAX_CONCURRENCY=4
BASEFLO_AGENT_MAX_REPAIR_ATTEMPTS=2

# ----- Auth -----
BASEFLO_SESSION_COOKIE_NAME=baseflo_session
BASEFLO_SESSION_COOKIE_SECURE=false     # true in staging/prod
BASEFLO_SESSION_TTL_DAYS=30
BASEFLO_SECRET_KEY=replace-me-with-32-random-bytes-base64

# ----- KMS -----
# Hosted: AWS KMS (production); local key for dev.
BASEFLO_KMS_PROVIDER=local              # local | aws_kms
BASEFLO_LOCAL_KEK_BASE64=replace-with-32-random-bytes-base64

# ----- Observability -----
BASEFLO_OTEL_ENABLED=false
BASEFLO_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
BASEFLO_SENTRY_DSN=                     # leave empty in dev
BASEFLO_SENTRY_TRACES_SAMPLE_RATE=0.1
